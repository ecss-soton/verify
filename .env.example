NODE_ENV="development"
DATABASE_URL=postgresql://postgres:password@localhost:5432/nextauth

NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://sotonverify.link/

# University of Southampton Azure AD Tenant ID - change only if you want to authenticate against a different tenant (for example a university account)
AZURE_AD_TENANT_ID="4a5378f9-29f4-4d3e-be89-669d03ada9d8"
AZURE_AD_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=

DISCORD_CLIENT_SECRET=
DISCORD_CLIENT_ID=

# Shared secret used to sign one-time Discord link tokens.
# Must be exactly the same value as LINK_TOKEN_SECRET in verify-bot.
# Generate one with: openssl rand -hex 32
LINK_TOKEN_SECRET=

MAIN_BOT_KEY=

# Discord user IDs of admins, comma-separated (use actual numeric Discord snowflake IDs)
ADMIN_DISCORD_IDS=
